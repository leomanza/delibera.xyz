# Copy to .env before any live run. Never commit .env.
# Values below are placeholders — real values stay out of the repo, always.
#
# Agent Connect rail (NEAR Intents).
# Production hosted API (mainnet, real funds):  https://api.agentsonintents.com
# Demo hosted gateway (mainnet NEAR chain):     https://api.demo.agentsonintents.com
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=naa_PartnerKeyPlaceholderStaysSecret
AGENT_CONNECT_GRANT_TOKEN=ngt_GrantedToAgentSecretStaysOut
AGENT_CONNECT_OWNER_ACCOUNT=owner-account-placeholder.near

# Ensue — live deliberation backbone (https://api.ensue-network.ai)
ENSUE_API_KEY=PlaceholderUntilHumanClaimsIt

# Settlement (verdict contract; owner key NEVER lives here — macOS keychain service near-mainnet-<account>)
NEAR_NETWORK=mainnet
